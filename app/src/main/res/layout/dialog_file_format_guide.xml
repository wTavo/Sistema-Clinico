<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/stroke_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_circle_teal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_table"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_guide_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/dialog_guide_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@color/stroke_border" />

        <ScrollView
            android:id="@+id/dialogScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- SECCIÓN 1: ARCHIVO CSV (EXCEL)                           -->
                <!-- ════════════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/dialog_guide_csv_title"
                    android:textColor="@color/secondary_crimson"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/dialog_guide_csv_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <!-- Tabla visual de Excel -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_chip_soft"
                    android:padding="6dp">

                    <TableLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TableRow
                            android:background="@color/primary_teal"
                            android:paddingVertical="8dp">

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="Folio"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="Fecha"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="RBC"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="Hb"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="Hct"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="WBC"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="Neut"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="Linf"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="PLT"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </TableRow>

                        <TableRow
                            android:background="@color/white"
                            android:paddingVertical="8dp">

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="LAB-001"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="25/08/2026"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="4.80"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="14.2"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="42.6"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="6.80"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="60.0"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="30.0"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:paddingHorizontal="8dp"
                                android:text="250000"
                                android:textColor="@color/text_primary"
                                android:textSize="12sp" />
                        </TableRow>
                    </TableLayout>
                </HorizontalScrollView>

                <!-- Botón de Descarga CSV directamente bajo el formato -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadCsvGuide"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/dialog_guide_csv_btn"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/secondary_crimson"
                    app:cornerRadius="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:background="@color/stroke_border" />

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- SECCIÓN 2: ARCHIVO TXT (BLOC DE NOTAS)                   -->
                <!-- ════════════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/dialog_guide_txt_title"
                    android:textColor="@color/tertiary_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/dialog_guide_txt_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_chip_soft"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:padding="12dp"
                    android:text="FOLIO = LAB-001\nFECHA = 25/08/2026\nRBC = 4.80\nHB = 14.2\nHCT = 42.6\nWBC = 6.80\nNEUT = 60.0\nLINF = 30.0\nPLT = 250000"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Botón de Descarga TXT directamente bajo el formato -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadTxtGuide"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/dialog_guide_txt_btn"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/tertiary_blue"
                    app:cornerRadius="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/stroke_border" />

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- SIGNIFICADO DE LOS CAMPOS                                -->
                <!-- ════════════════════════════════════════════════════════ -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/dialog_guide_fields_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="• FOLIO: Identificador o número de muestra\n• FECHA: Fecha del estudio (DD/MM/AAAA)\n• RBC: Glóbulos Rojos (millones/µL)\n• HB: Hemoglobina (g/dL)\n• HCT: Hematocrito (%)\n• WBC: Glóbulos Blancos (miles/µL)\n• NEUT: Porcentaje de Neutrófilos (%)\n• LINF: Porcentaje de Linfocitos (%)\n• PLT: Recuento de Plaquetas (/µL)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_chip_soft"
                    android:padding="10dp"
                    android:text="@string/dialog_guide_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>

        <!-- Botón Cerrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuideClose"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:text="@string/hub_close_btn"
            android:textColor="@color/white"
            android:textSize="13.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_teal"
            app:cornerRadius="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
